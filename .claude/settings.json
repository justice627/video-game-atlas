{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-data.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-agent.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run build:data)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npm run golden:update)",
      "Bash(npm run verify:sources:*)",
      "Bash(npm run sync:wikidata)",
      "Bash(npm run fetch:wikidata)",
      "Bash(npm run place:lookup:*)",
      "Bash(npm run pipeline:*)"
    ]
  }
}
